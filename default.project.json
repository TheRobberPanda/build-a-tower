{
  "name": "BuildATower",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "Tests": {
        "$path": "tests"
      }
    },
    "ServerStorage": {
      "DevPackages": {
        "$path": "DevPackages"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "QAClient": {
          "$path": "qa/QAClient.client.luau"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14.5,
        "Brightness": 1.6,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "ExposureCompensation": -0.15,
        "OutdoorAmbient": [
          0.5,
          0.5,
          0.55
        ],
        "Ambient": [
          0.35,
          0.35,
          0.4
        ]
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.25,
          "Offset": 0.25,
          "Haze": 0.6,
          "Glare": 0.3,
          "Color": [
            0.78,
            0.82,
            0.9
          ],
          "Decay": [
            0.42,
            0.48,
            0.6
          ]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.4,
          "Size": 24,
          "Threshold": 2
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.25,
          "Contrast": 0.12
        }
      }
    }
  }
}
