{
  "name": "BuildATower",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "Tests": {
        "$path": "tests"
      }
    },
    "ServerStorage": {
      "DevPackages": {
        "$path": "DevPackages"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "DevCameraOcclusionMode": "Invisicam"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "QAClient": {
          "$path": "qa/QAClient.client.luau"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 13.5,
        "Brightness": 2,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "ExposureCompensation": 0,
        "OutdoorAmbient": [
          0.55,
          0.55,
          0.55
        ],
        "Ambient": [
          0.4,
          0.4,
          0.4
        ]
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.2,
          "Offset": 0.25,
          "Haze": 0.3,
          "Glare": 0,
          "Color": [
            0.95,
            0.95,
            0.95
          ],
          "Decay": [
            0.6,
            0.7,
            0.85
          ]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.4,
          "Size": 24,
          "Threshold": 2
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.3,
          "Contrast": 0.08,
          "TintColor": [
            1,
            1,
            0.98
          ]
        }
      }
    }
  }
}
